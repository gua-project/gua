#pragma once
#define GUA_COMPILED_REMOTE @GUA_COMPILED_REMOTE@
#define GUA_COMPILED_PLAYER_ONLY @GUA_COMPILED_PLAYER_ONLY@
#define GUA_DISTRIBUTION_FLAVOR "@GUA_DISTRIBUTION_FLAVOR@"
#define GUA_REMOTE_CEILING "@GUA_REMOTE_CEILING@"
#define GUA_BUILD_TRANSPORTS_JSON "@GUA_TRANSPORTS_JSON@"
#define GUA_SOURCE_COMMIT "@GUA_SOURCE_COMMIT@"
#if @GUA_RELEASE_ONLY@ && !GUA_BUILD_IS_RELEASE
#error This Gua variant requires the actual Release configuration
#endif
#define GUA_DEFAULT_OBSERVATION_PROFILE (GUA_COMPILED_PLAYER_ONLY ? GUA_OBSERVATION_PROFILE_PLAYER : GUA_OBSERVATION_PROFILE_DEBUG)
inline bool gua_build_profile_allowed(int profile) {
    return profile == GUA_OBSERVATION_PROFILE_PLAYER || (!GUA_COMPILED_PLAYER_ONLY && profile == GUA_OBSERVATION_PROFILE_DEBUG);
}
