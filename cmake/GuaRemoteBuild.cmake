set(GUA_DISTRIBUTION_FLAVOR "shipping" CACHE STRING "Gua purpose: shipping, development, qa, ai-player")
set_property(CACHE GUA_DISTRIBUTION_FLAVOR PROPERTY STRINGS shipping development qa ai-player)
option(GUA_ENABLE_REMOTE_AUTOMATION "Compile Gua remote transports and dispatch (explicit opt-in)." OFF)
option(GUA_STAGE_IN_SAMPLE "Stage development binaries in the source sample for existing smoke workflows." OFF)
if(GUA_STAGE_IN_SAMPLE AND NOT GUA_DISTRIBUTION_FLAVOR STREQUAL "development")
    message(FATAL_ERROR "Source sample staging is only permitted for development; distribute other variants from their isolated build tree")
endif()
if(GUA_STAGE_IN_SAMPLE)
    set(GUA_GODOT_ADDON_DIRECTORY "${CMAKE_SOURCE_DIR}/examples/godot-gdscript/addons/gua")
    set(GUA_DOTNET_ADDON_DIRECTORY "${CMAKE_SOURCE_DIR}/examples/dotnet-godot/addons/gua")
else()
    set(GUA_GODOT_ADDON_DIRECTORY "${CMAKE_BINARY_DIR}/stage/addons/gua")
    set(GUA_DOTNET_ADDON_DIRECTORY "${CMAKE_BINARY_DIR}/stage/dotnet-godot/addons/gua")
endif()
if(NOT GUA_DISTRIBUTION_FLAVOR MATCHES "^(shipping|development|qa|ai-player)$")
    message(FATAL_ERROR "Unknown GUA_DISTRIBUTION_FLAVOR")
endif()
if(GUA_DISTRIBUTION_FLAVOR STREQUAL "shipping" AND GUA_ENABLE_REMOTE_AUTOMATION)
    message(FATAL_ERROR "shipping cannot contain remote automation; select an explicit remote variant")
endif()
if(GUA_DISTRIBUTION_FLAVOR MATCHES "^(qa|ai-player)$" AND NOT GUA_ENABLE_REMOTE_AUTOMATION)
    message(FATAL_ERROR "qa and ai-player require GUA_ENABLE_REMOTE_AUTOMATION=ON")
endif()
set(GUA_COMPILED_REMOTE 0)
set(GUA_COMPILED_PLAYER_ONLY 0)
set(GUA_REMOTE_CEILING "none")
if(GUA_ENABLE_REMOTE_AUTOMATION)
    set(GUA_COMPILED_REMOTE 1)
    set(GUA_REMOTE_CEILING "debug")
    if(GUA_DISTRIBUTION_FLAVOR STREQUAL "ai-player")
        set(GUA_COMPILED_PLAYER_ONLY 1)
        set(GUA_REMOTE_CEILING "player")
    endif()
endif()
set(GUA_RELEASE_ONLY 0)
if(GUA_DISTRIBUTION_FLAVOR MATCHES "^(shipping|qa|ai-player)$")
    set(GUA_RELEASE_ONLY 1)
    if(CMAKE_CONFIGURATION_TYPES)
        set(CMAKE_CONFIGURATION_TYPES "Release" CACHE STRING "Allowed configurations for this variant" FORCE)
    elseif(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
        message(FATAL_ERROR "${GUA_DISTRIBUTION_FLAVOR} requires CMAKE_BUILD_TYPE=Release")
    endif()
endif()
function(gua_finalize_remote_build)
    set(GUA_TRANSPORTS_JSON "[]")
    if(GUA_BUILD_WS_BRIDGE AND GUA_DESKTOP_NATIVE AND NOT EMSCRIPTEN)
        set(GUA_TRANSPORTS_JSON "[\\\"websocket\\\"]")
    elseif(GUA_ENABLE_REMOTE_AUTOMATION AND EMSCRIPTEN)
        set(GUA_TRANSPORTS_JSON "[\\\"webmcp\\\"]")
    endif()
    execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
        OUTPUT_VARIABLE GUA_SOURCE_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT GUA_SOURCE_COMMIT)
        set(GUA_SOURCE_COMMIT "unknown")
    endif()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/build_config.h.in" "${CMAKE_BINARY_DIR}/generated/gua/build_config.h" @ONLY)
endfunction()
include_directories("${CMAKE_BINARY_DIR}/generated")
add_compile_definitions(GUA_BUILD_CONFIGURATION="$<CONFIG>" GUA_BUILD_IS_RELEASE=$<IF:$<CONFIG:Release>,1,0>)
