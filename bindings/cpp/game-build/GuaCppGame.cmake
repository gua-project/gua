include_guard(GLOBAL)

function(gua_protect_cpp_game target)
  set(sdk "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  cmake_parse_arguments(G "" "MODE;NOTIFY_FALLBACK;FAILURE_FALLBACK" "PLUGINS" ${ARGN})
  if(G_UNPARSED_ARGUMENTS OR G_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "Invalid gua_protect_cpp_game arguments.")
  endif()
  if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Gua protected C++ games currently require Windows x64 MSVC.")
  endif()
  if(NOT G_MODE)
    set(G_MODE off)
  endif()
  if(NOT G_MODE MATCHES "^(off|testing|player)$")
    message(FATAL_ERROR "Gua game MODE must be off, testing, or player.")
  endif()
  get_target_property(kind ${target} TYPE)
  if(NOT kind STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "gua_protect_cpp_game requires the game executable; declare its SDK-consuming DLL targets in PLUGINS.")
  endif()
  string(SHA256 id "${CMAKE_CURRENT_SOURCE_DIR}/${target}")
  string(SUBSTRING "${id}" 0 20 id)
  set(policy "GameSecurity_${id}.dll")
  set(mode 0)
  if(G_MODE STREQUAL testing)
    set(mode 1)
  elseif(G_MODE STREQUAL player)
    set(mode 2)
  endif()
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/gua-game-${target}")
  file(MAKE_DIRECTORY "${generated}")
  file(WRITE "${generated}/gua_game_policy_config.h" "#define GUA_GAME_POLICY_LIBRARY L\"${policy}\"\n#define GUA_GAME_POLICY_MODE ${mode}\n")
  set(modules ${target} ${G_PLUGINS})
  foreach(module IN LISTS modules)
    if(NOT TARGET ${module})
      message(FATAL_ERROR "Unknown SDK-consuming game module ${module}.")
    endif()
    get_target_property(imported ${module} IMPORTED)
    get_target_property(module_kind ${module} TYPE)
    if(imported OR (NOT module STREQUAL target AND NOT module_kind MATCHES "^(SHARED_LIBRARY|MODULE_LIBRARY)$"))
      message(FATAL_ERROR "PLUGINS must name buildable SDK-consuming DLL targets. A prebuilt DLL with eager Gua imports needs a delay-load build from its supplier; unrelated DLLs need no guard.")
    endif()
    target_sources(${module} PRIVATE "${sdk}/delay_guard.cpp")
    target_include_directories(${module} PRIVATE "${generated}")
    target_include_directories(${module} PUBLIC "${sdk}/include")
    target_compile_features(${module} PRIVATE cxx_std_20)
    if(NOT module STREQUAL target)
      target_compile_definitions(${module} PRIVATE GUA_GAME_DEPENDENT_MODULE=1)
    endif()
    target_link_libraries(${module} PRIVATE "${sdk}/${G_MODE}/gua.lib" "${sdk}/${G_MODE}/gua_runtime.lib" delayimp)
    target_link_options(${module} PRIVATE /DELAYLOAD:gua.dll /DELAYLOAD:gua_runtime.dll)
    if(NOT G_MODE STREQUAL off)
      target_compile_definitions(${module} PRIVATE GUA_REMOTE_AUTOMATION=1)
    endif()
    if(G_MODE STREQUAL player)
      target_compile_definitions(${module} PRIVATE GUA_PLAYER_ONLY=1)
    endif()
    foreach(hook NOTIFY FAILURE)
      if(G_${hook}_FALLBACK)
        if(NOT G_${hook}_FALLBACK MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
          message(FATAL_ERROR "Delay fallback must be a global function identifier.")
        endif()
        target_compile_definitions(${module} PRIVATE "GUA_GAME_${hook}_FALLBACK=${G_${hook}_FALLBACK}")
      endif()
    endforeach()
  endforeach()
  set(extra "")
  foreach(plugin IN LISTS G_PLUGINS)
    add_dependencies(${target} ${plugin})
    list(APPEND extra "$<TARGET_FILE:${plugin}>")
  endforeach()
  # Run on every game build, including relinks of native plugin targets.
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND dotnet "${sdk}/tools/Gua.GameBuild.dll" prepare-cpp "${sdk}" "${G_MODE}" "$<TARGET_FILE:${target}>" "${policy}" ${extra}
    VERBATIM)
  add_custom_target(${target}_gua_package ALL
    COMMAND dotnet "${sdk}/tools/Gua.GameBuild.dll" prepare-cpp "${sdk}" "${G_MODE}" "$<TARGET_FILE:${target}>" "${policy}" ${extra}
    DEPENDS ${target} ${G_PLUGINS} VERBATIM)
endfunction()
