<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Gua.Core\Gua.Core.csproj" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Gua.Testing</PackageId>
    <Version>$(GuaPackageVersion)</Version>
    <Authors>Gua contributors</Authors>
    <Title>Gua Testing</Title>
    <Description>Assertion, locator, wait, and test-host helpers for Gua runtime UI automation.</Description>
    <PackageTags>gua;game-ui;automation;testing;xunit;nunit;mstest</PackageTags>
    <PackageProjectUrl>https://github.com/gua-project/gua</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gua-project/gua</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(GuaPackageOutputPath)</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../../../protocol/schema/*.schema.json;../../../../protocol/schema/*.mjs" Pack="true" PackagePath="schemas/" />
    <EmbeddedResource Include="../../../../protocol/schema/*.schema.json" LogicalName="Gua.Trace.%(Filename)%(Extension)" />
    <EmbeddedResource Update="../../../../protocol/schema/ui-tree.schema.json" LogicalName="Gua.Trace.UiTree.schema.json" />
    <EmbeddedResource Update="../../../../protocol/schema/world-object-tree.schema.json" LogicalName="Gua.Trace.WorldTree.schema.json" />
    <EmbeddedResource Include="../../../../protocol/schema/trace-observe-semantics.mjs" LogicalName="Gua.Distribution.trace-observe-semantics.mjs" />
    <EmbeddedResource Include="../../../../LICENSE" LogicalName="Gua.Distribution.LICENSE" />
    <EmbeddedResource Include="../../../../artifacts/trace-viewer/version.json" LogicalName="Gua.Distribution.Viewer.version.json" Condition="Exists('../../../../artifacts/trace-viewer/version.json')" />
    <EmbeddedResource Include="../../../../artifacts/trace-viewer/Viewer.LICENSES.txt" LogicalName="Gua.Distribution.Viewer.LICENSES.txt" Condition="Exists('../../../../artifacts/trace-viewer/Viewer.LICENSES.txt')" />
    <None Include="../../../../artifacts/trace-viewer/Viewer.LICENSES.txt;../../../../LICENSE" Pack="true" PackagePath="trace/" Condition="Exists('../../../../artifacts/trace-viewer/Viewer.LICENSES.txt')" />
    <None Include="../../../../protocol/schema/spatial-r1.schema.json;../../../../protocol/schema/spatial-host-r1.schema.json" Pack="true" PackagePath="trace/" />
    <EmbeddedResource Include="../../../../artifacts/trace-viewer/viewer.js" LogicalName="Gua.Trace.Viewer.js"
                      Condition="Exists('../../../../artifacts/trace-viewer/viewer.js')" />
    <None Include="../../../../protocol/schema/trace.schema.json" Pack="true" PackagePath="trace/" />
    <None Include="../../../../protocol/schema/trace-screenshot.schema.json;../../../../protocol/schema/trace-lifecycle.schema.json" Pack="true" PackagePath="trace/" />
    <None Include="../../../../protocol/schema/trace-observe-semantics.mjs" Pack="true" PackagePath="trace/" />
    <None Include="../../../../protocol/schema/observe-transport-v1.schema.json;../../../../protocol/schema/observe-v1.schema.json;../../../../protocol/schema/enum-catalog-v1.schema.json;../../../../protocol/schema/value-v1.schema.json" Pack="true" PackagePath="trace/" />
    <None Include="../../../../protocol/schema/diagnostics.schema.json;../../../../protocol/schema/version.schema.json;../../../../protocol/schema/logs.schema.json;../../../../protocol/schema/screenshot.schema.json;../../../../protocol/schema/ui-tree.schema.json;../../../../protocol/schema/trace-diagnostics.schema.json;../../../../protocol/schema/trace-recording.schema.json" Pack="true" PackagePath="trace/" />
    <None Include="../../../../artifacts/trace-viewer/index.html" Pack="true" PackagePath="trace/"
          Condition="Exists('../../../../artifacts/trace-viewer/index.html')" />
    <None Include="../../../../artifacts/trace-viewer/viewer.js;../../../../artifacts/trace-viewer/version.json" Pack="true" PackagePath="trace/"
          Condition="Exists('../../../../artifacts/trace-viewer/viewer.js')" />
  </ItemGroup>
  <Target Name="RequireTraceViewerForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('../../../../artifacts/trace-viewer/viewer.js')"
           Text="Build the version-pinned Trace Viewer before packaging: bun run --filter @gua/inspector build:trace" />
    <Error Condition="!Exists('../../../../artifacts/trace-viewer/index.html') Or !Exists('../../../../artifacts/trace-viewer/version.json') Or !Exists('../../../../artifacts/trace-viewer/Viewer.LICENSES.txt')"
           Text="The packaged Trace Viewer requires its HTML, provenance metadata and third-party license notices." />
  </Target>
</Project>
