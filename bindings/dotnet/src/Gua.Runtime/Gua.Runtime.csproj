<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Gua.Core\Gua.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Gua.Runtime</PackageId>
    <Version>$(GuaPackageVersion)</Version>
    <Authors>Gua contributors</Authors>
    <Title>Gua Runtime</Title>
    <Description>Managed wrapper over the shared Gua runtime C ABI for engine adapters.</Description>
    <PackageProjectUrl>https://github.com/gua-project/gua</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gua-project/gua</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(GuaPackageOutputPath)</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\build\windows-msvc-release\native\gua-runtime\Release\gua_runtime.dll" Pack="true" PackagePath="runtimes\win-x64\native\gua_runtime.dll" Visible="false" Condition="'$(GuaNativeAssetsRoot)' == '' And Exists('..\..\..\..\build\windows-msvc-release\native\gua-runtime\Release\gua_runtime.dll')" />
    <None Include="$(GuaNativeAssetsRoot)/win-x64/gua_runtime.dll" Pack="true" PackagePath="runtimes/win-x64/native/gua_runtime.dll" Visible="false" Condition="'$(GuaNativeAssetsRoot)' != '' And Exists('$(GuaNativeAssetsRoot)/win-x64/gua_runtime.dll')" />
    <None Include="$(GuaNativeAssetsRoot)/linux-x64/libgua_runtime.so" Pack="true" PackagePath="runtimes/linux-x64/native/libgua_runtime.so" Visible="false" Condition="'$(GuaNativeAssetsRoot)' != '' And Exists('$(GuaNativeAssetsRoot)/linux-x64/libgua_runtime.so')" />
    <None Include="$(GuaNativeAssetsRoot)/osx-x64/libgua_runtime.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/libgua_runtime.dylib" Visible="false" Condition="'$(GuaNativeAssetsRoot)' != '' And Exists('$(GuaNativeAssetsRoot)/osx-x64/libgua_runtime.dylib')" />
    <None Include="$(GuaNativeAssetsRoot)/osx-arm64/libgua_runtime.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/libgua_runtime.dylib" Visible="false" Condition="'$(GuaNativeAssetsRoot)' != '' And Exists('$(GuaNativeAssetsRoot)/osx-arm64/libgua_runtime.dylib')" />
  </ItemGroup>

  <Target Name="ValidateGuaRuntimeNativeAssets" BeforeTargets="GenerateNuspec" Condition="'$(GuaNativeAssetsRoot)' != ''">
    <Error Condition="!Exists('$(GuaNativeAssetsRoot)/win-x64/gua_runtime.dll')" Text="Missing win-x64 Gua.Runtime native asset below $(GuaNativeAssetsRoot)." />
    <Error Condition="!Exists('$(GuaNativeAssetsRoot)/linux-x64/libgua_runtime.so')" Text="Missing linux-x64 Gua.Runtime native asset below $(GuaNativeAssetsRoot)." />
    <Error Condition="!Exists('$(GuaNativeAssetsRoot)/osx-x64/libgua_runtime.dylib')" Text="Missing osx-x64 Gua.Runtime native asset below $(GuaNativeAssetsRoot)." />
    <Error Condition="!Exists('$(GuaNativeAssetsRoot)/osx-arm64/libgua_runtime.dylib')" Text="Missing osx-arm64 Gua.Runtime native asset below $(GuaNativeAssetsRoot)." />
  </Target>

  <Target Name="RequireGuaRuntimeNativeAssetsForPack" BeforeTargets="GenerateNuspec"
          Condition="'$(GuaNativeAssetsRoot)' == '' And !Exists('..\..\..\..\build\windows-msvc-release\native\gua-runtime\Release\gua_runtime.dll')">
    <Error Text="Packing Gua.Runtime requires GuaNativeAssetsRoot with all four RID assets, or the legacy Windows Release gua_runtime.dll build." />
  </Target>
</Project>
