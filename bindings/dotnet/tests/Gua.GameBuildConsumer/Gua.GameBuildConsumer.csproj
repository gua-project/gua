<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gua.Runtime/Gua.Runtime.csproj" />
    <Compile Include="../Gua.BuildVariants/Program.cs" />
    <Compile Include="$(GuaGamePolicySource)" />
  </ItemGroup>
  <Target Name="RequireGameOwnedPolicy" BeforeTargets="CoreCompile">
    <Error Condition="'$(GuaGamePolicySource)' == '' Or !Exists('$(GuaGamePolicySource)')" Text="Generate the game-owned policy before building this consumer." />
  </Target>
</Project>
