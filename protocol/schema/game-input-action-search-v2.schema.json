{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua.dev/schema/game-input-action-search-v2.schema.json",
  "title": "Gua Game Input Action Search Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionEpoch",
    "revision",
    "context",
    "count",
    "truncated",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessionEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "truncated": {
      "type": "boolean"
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "game-input-actions-v2.schema.json#/$defs/action"
      }
    }
  }
}
