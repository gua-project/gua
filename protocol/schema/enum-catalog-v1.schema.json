{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua.dev/schema/enum-catalog-v1.schema.json",
  "title": "Gua Enum Catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "enums"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "enumType",
          "members"
        ],
        "additionalProperties": false,
        "properties": {
          "enumType": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]*(?:\\.[A-Za-z_][A-Za-z_0-9]*)+$"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
