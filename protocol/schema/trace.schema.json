{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua.orizika.com/schema/trace-v1.json",
  "title": "Gua Trace v1",
  "oneOf": [{ "$ref": "#/$defs/manifest" }, { "$ref": "#/$defs/event" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "uint64": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "outcome": { "enum": ["unknown", "passed", "failed", "interrupted"] },
    "blob": { "type": "string", "pattern": "^(snapshots|attachments)/[a-f0-9]{64}\\.json$" },
    "request": {
      "type": "object", "required": ["sourceId", "sessionEpoch", "requestId"],
      "properties": { "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "sessionEpoch": { "$ref": "#/$defs/uint64" }, "requestId": { "$ref": "#/$defs/uint64" } }
    },
    "manifest": {
      "type": "object", "required": ["schemaVersion", "traceId", "captureMode", "savePolicy", "profile", "primaryOutcome", "finalized", "collectionClock", "startedAt", "lastSequence", "quality"],
      "properties": {
        "schemaVersion": { "const": 1 }, "traceId": { "$ref": "#/$defs/id" },
        "captureMode": { "enum": ["recent", "streaming"] }, "savePolicy": { "enum": ["onFailure", "always"] },
        "profile": { "enum": ["debug", "player"] }, "primaryOutcome": { "$ref": "#/$defs/outcome" },
        "finalized": { "type": "boolean" }, "collectionClock": { "type": "string" }, "startedAt": { "type": "string" },
        "lastSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "quality": {
          "type": "object", "required": ["detailStopped", "evictedSteps", "droppedEvents", "issues"],
          "properties": { "detailStopped": { "type": "boolean" }, "evictedSteps": { "type": "integer", "minimum": 0 }, "droppedEvents": { "type": "integer", "minimum": 0 }, "issues": { "type": "array", "items": { "type": "string" }, "maxItems": 64 } }
        }
      }
    },
    "event": {
      "type": "object", "required": ["schemaVersion", "traceId", "sequence", "eventId", "stepId", "type", "collectedMilliseconds", "data"],
      "properties": {
        "schemaVersion": { "const": 1 }, "traceId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "eventId": { "type": "string", "minLength": 1 },
        "stepId": { "$ref": "#/$defs/id" }, "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "collectedMilliseconds": { "type": "number", "minimum": 0 }, "data": {}
      }
    }
  }
}
