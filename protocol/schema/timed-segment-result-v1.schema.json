{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua.dev/schema/timed-segment-result-v1.schema.json",
  "title": "Values-free Timed Segment v1 Trace attachment",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "result"],
  "properties": { "schemaVersion": { "const": 1 }, "result": { "$ref": "#/$defs/result" } },
  "$defs": {
    "time": { "type": ["number", "null"], "minimum": 0 },
    "input": {
      "type": "object", "additionalProperties": false,
      "allOf": [{"then":{"properties":{"resultReceivedMilliseconds":{"type":"number"}}},"if":{"anyOf":[{"properties":{"hostAppliedMilliseconds":{"type":"number"}},"required":["hostAppliedMilliseconds"]},{"properties":{"succeeded":{"type":"boolean"}},"required":["succeeded"]},{"properties":{"errorCode":{"type":"integer"}},"required":["errorCode"]}]}},{"then":{"properties":{"succeeded":{"type":"boolean"},"errorCode":{"type":"integer"},"requestId":{"type":"string"},"sentMilliseconds":{"type":"number"}}},"if":{"properties":{"resultReceivedMilliseconds":{"type":"number"}},"required":["resultReceivedMilliseconds"]}},{"then":{"properties":{"sentMilliseconds":{"type":"number"}}},"if":{"properties":{"requestId":{"type":"string"}},"required":["requestId"]}}],
      "required": ["index", "scheduledMilliseconds", "sentMilliseconds", "requestId", "resultReceivedMilliseconds", "hostAppliedMilliseconds", "succeeded", "errorCode"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 999 },
        "scheduledMilliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "sentMilliseconds": { "$ref": "#/$defs/time" },
        "requestId": {"allOf":[{"pattern":"^[1-9][0-9]{0,19}(?![\\s\\S])"},{"pattern":"^(?:[0-9]{1,19}|0[0-9]{19}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4])(?![\\s\\S])"}],"type":["string","null"]},
        "resultReceivedMilliseconds": { "$ref": "#/$defs/time" },
        "hostAppliedMilliseconds": { "$ref": "#/$defs/time" },
        "succeeded": { "type": ["boolean", "null"] },
        "errorCode": { "type": ["integer", "null"] }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "if": { "properties": { "applicationTimingConfirmed": { "const": true } }, "required": ["applicationTimingConfirmed"] },
      "allOf": [{ "if": { "properties": { "outcome": { "const": 0 } }, "required": ["outcome"] }, "then": { "properties": { "cleanupSucceeded": { "const": true }, "neutralConfirmed": { "const": true }, "failureCode": { "type": "null" }, "inputs": { "items": { "properties": { "sentMilliseconds": { "type": "number" }, "requestId": { "type": "string" }, "resultReceivedMilliseconds": { "type": "number" }, "succeeded": { "const": true } } } } } } }, {"if":{"required":["clock"],"properties":{"clock":{"const":1}}},"then":{"properties":{"simulationScope":{"minLength":1,"type":"string","pattern":"\\S"}}}},{"if":{"required":["outcome"],"properties":{"outcome":{"const":1}}},"then":{"properties":{"failureCode":{"enum":["lifecycle-source-changed","lifecycle-evidence-gap","lease-expired-before-release","lifecycle-or-session-unconfirmed","host-health-failed","host-rejected-or-failed","application-time-unconfirmed","host-or-clock-exception","cleanup-unconfirmed","application-order-or-tick-violation"]}}}},{"if":{"required":["outcome"],"properties":{"outcome":{"const":2}}},"then":{"properties":{"failureCode":{"enum":["caller-cancelled"]}}}},{"if":{"required":["outcome"],"properties":{"outcome":{"const":3}}},"then":{"properties":{"failureCode":{"enum":["execution-timeout","completion-or-boundary-timeout"]}}}},{"if":{"required":["outcome"],"properties":{"outcome":{"const":4}}},"then":{"properties":{"failureCode":{"enum":["max-lateness-exceeded","send-exceeded-max-lateness","application-time-violation"]}}}}],
      "then": { "properties": { "outcome": { "const": 0 }, "cleanupSucceeded": { "const": true }, "neutralConfirmed": { "const": true }, "inputs": { "items": { "properties": { "sentMilliseconds": { "type": "number" }, "requestId": { "type": "string" }, "resultReceivedMilliseconds": { "type": "number" }, "hostAppliedMilliseconds": { "type": "number" }, "succeeded": { "const": true } } } } } },
      "required": ["outcome", "cleanupSucceeded", "neutralConfirmed", "failureCode", "clock", "simulationScope", "maxLatenessMilliseconds", "executionTimeoutMilliseconds", "cleanupTimeoutMilliseconds", "applicationTimingConfirmed", "inputs"],
      "properties": {
        "outcome": { "enum": [0, 1, 2, 3, 4], "description": "Succeeded, failed, cancelled, timed-out, late" },
        "cleanupSucceeded": { "type": "boolean" }, "neutralConfirmed": { "type": "boolean" },
        "failureCode": { "enum": [null, "lifecycle-source-changed", "lifecycle-evidence-gap", "lease-expired-before-release", "lifecycle-or-session-unconfirmed", "host-health-failed", "host-rejected-or-failed", "application-time-unconfirmed", "application-time-violation", "execution-timeout", "completion-or-boundary-timeout", "max-lateness-exceeded", "send-exceeded-max-lateness", "caller-cancelled", "host-or-clock-exception", "cleanup-unconfirmed", "application-order-or-tick-violation"] }, "clock": { "enum": [0, 1] },
        "simulationScope": { "type": ["string", "null"] },
        "maxLatenessMilliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "executionTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "cleanupTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "applicationTimingConfirmed": { "type": "boolean" },
        "inputs": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/input" } }
      }
    }
  }
}
