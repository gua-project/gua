{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua.dev/schema/timed-segment-result-v1.schema.json",
  "title": "Values-free Timed Segment v1 Trace attachment",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "result"],
  "properties": { "schemaVersion": { "const": 1 }, "result": { "$ref": "#/$defs/result" } },
  "$defs": {
    "time": { "type": ["number", "null"], "minimum": 0 },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "scheduledMilliseconds", "sentMilliseconds", "requestId", "resultReceivedMilliseconds", "hostAppliedMilliseconds", "succeeded", "errorCode"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 999 },
        "scheduledMilliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "sentMilliseconds": { "$ref": "#/$defs/time" },
        "requestId": { "type": ["string", "null"], "pattern": "^[0-9]{1,20}$" },
        "resultReceivedMilliseconds": { "$ref": "#/$defs/time" },
        "hostAppliedMilliseconds": { "$ref": "#/$defs/time" },
        "succeeded": { "type": ["boolean", "null"] },
        "errorCode": { "type": ["integer", "null"] }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "cleanupSucceeded", "neutralConfirmed", "failureCode", "clock", "simulationScope", "maxLatenessMilliseconds", "executionTimeoutMilliseconds", "cleanupTimeoutMilliseconds", "applicationTimingConfirmed", "inputs"],
      "properties": {
        "outcome": { "enum": [0, 1, 2, 3, 4], "description": "Succeeded, failed, cancelled, timed-out, late" },
        "cleanupSucceeded": { "type": "boolean" }, "neutralConfirmed": { "type": "boolean" },
        "failureCode": { "type": ["string", "null"] }, "clock": { "enum": [0, 1] },
        "simulationScope": { "type": ["string", "null"] },
        "maxLatenessMilliseconds": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "executionTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "cleanupTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "applicationTimingConfirmed": { "type": "boolean" },
        "inputs": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/input" } }
      }
    }
  }
}
